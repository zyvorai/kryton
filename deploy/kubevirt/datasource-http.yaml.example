# Example: CDI HTTP import for a Kryton golden image (WinForge-style publish path).
#
# 1. Upload your qcow2 to an HTTP(S) object store
# 2. Replace the URL below
# 3. kubectl apply -f deploy/kubevirt/datasource-http.yaml
#
# Image ID must match the Kryton catalog (e.g. windows-server-2025).
---
apiVersion: v1
kind: Namespace
metadata:
  name: kryton-images
  labels:
    app.kubernetes.io/managed-by: kryton
---
apiVersion: cdi.kubevirt.io/v1beta1
kind: DataVolume
metadata:
  name: windows-server-2025-golden
  namespace: kryton-images
  labels:
    app.kubernetes.io/managed-by: kryton
spec:
  source:
    http:
      url: https://YOUR-OBJECT-STORE/windows-server-2025-golden.qcow2
  storage:
    resources:
      requests:
        storage: 80Gi
    # storageClassName: your-storage-class
---
apiVersion: cdi.kubevirt.io/v1beta1
kind: DataSource
metadata:
  name: windows-server-2025
  namespace: kryton-images
  labels:
    app.kubernetes.io/managed-by: kryton
spec:
  source:
    pvc:
      name: windows-server-2025-golden
      namespace: kryton-images
